{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "PExprIR",
    "scopeName": "source.pexprir",
    "fileTypes": ["pexprir"],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#attributes"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#literals"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#identifiers"
        },
        {
            "include": "#labels"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.pexprir",
                    "begin": "//",
                    "end": "$"
                },
                {
                    "name": "comment.block.pexprir",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "attributes": {
            "patterns": [
                {
                    "name": "entity.other.attribute-name.pexprir",
                    "begin": "\\[\\[",
                    "end": "\\]\\]",
                    "patterns": [
                        {
                            "name": "keyword.attribute.pexprir",
                            "match": "\\b(extern|pure)\\b"
                        },
                        {
                            "name": "punctuation.separator.attribute.pexprir",
                            "match": ","
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.pexprir",
                    "match": "\\b(fn|endfn|return|goto|br)\\b"
                },
                {
                    "name": "keyword.operator.pexprir",
                    "match": "\\b(assign|add|sub|mul|div|pow|mod|and|or|ls|gt|le|ge|eq|neq|pos|neg|not|cast|nop|swizzle|vec|access|call|phi)\\b"
                },
                {
                    "name": "constant.language.boolean.pexprir",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.pexprir",
                    "match": "\\b(bool|int|num|vec2|vec3|vec4|str)\\b"
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "name": "constant.numeric.integer.pexprir",
                    "match": "\\b(0[bB][01]+|0[oO][0-7]+|0[xX][0-9a-fA-F]+|[0-9]+)\\b"
                },
                {
                    "name": "constant.numeric.float.pexprir",
                    "match": "\\b[0-9]+\\.[0-9]*([eE][+-]?[0-9]+)?\\b|\\b[0-9]*\\.[0-9]+([eE][+-]?[0-9]+)?\\b|\\b[0-9]+[eE][+-]?[0-9]+\\b"
                },
                {
                    "name": "string.quoted.double.pexprir",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.pexprir",
                            "match": "\\\\[\\\\\"'tnrabvfr0xuU]"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.pexprir",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.pexprir",
                            "match": "\\\\[\\\\\"'tnrabvfr0xuU]"
                        }
                    ]
                },
                {
                    "name": "constant.other.vector.pexprir",
                    "begin": "\\[",
                    "end": "\\]",
                    "patterns": [
                        {
                            "include": "#literals"
                        },
                        {
                            "name": "punctuation.separator.vector.pexprir",
                            "match": ","
                        }
                    ]
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.pexprir",
                    "match": "="
                },
                {
                    "name": "keyword.operator.arrow.pexprir",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.colon.pexprir",
                    "match": ":"
                },
                {
                    "name": "punctuation.parenthesis.pexprir",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.brace.pexprir",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.bracket.pexprir",
                    "match": "[\\[\\]]"
                },
                {
                    "name": "punctuation.separator.comma.pexprir",
                    "match": ","
                },
                {
                    "name": "punctuation.accessor.pexprir",
                    "match": "\\."
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.parameter.pexprir",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*(?=:|\\)|,|$))"
                },
                {
                    "name": "variable.other.pexprir",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\.[0-9]+\\b"
                },
                {
                    "name": "variable.temporary.pexprir",
                    "match": "\\b\\%\\.[0-9]+\\b"
                },
                {
                    "name": "variable.function.call.pexprir",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\[)"
                }
            ]
        },
        "labels": {
            "patterns": [
                {
                    "name": "entity.name.label.pexprir",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=:)"
                }
            ]
        }
    }
}