{
    "comments": {
        "lineComment": "//",
        "blockComment": ["/*", "*/"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["[[", "]]"],
        ["fn", "endfn"]
    ],
    "autoClosingPairs": [
        {"open": "\"", "close": "\"", "notIn": ["string", "comment"]},
        {"open": "'", "close": "'", "notIn": ["string", "comment"]},
        {"open": "{", "close": "}", "notIn": ["string", "comment"]},
        {"open": "[", "close": "]", "notIn": ["string", "comment"]},
        {"open": "(", "close": ")", "notIn": ["string", "comment"]},
        {"open": "[[", "close": "]]", "notIn": ["string", "comment"]}
    ],
    "autoCloseBefore": ";:.,=}])| \t\n\r",
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"],
        ["[[", "]]"]
    ],
    "folding": {
        "markers": {
            "start": "^\\s*/\\*",
            "end": "^\\s*\\*/"
        }
    },
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\]\\{\\}\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
    "indentationRules": {
        "increaseIndentPattern": "^.*\\fn.*\\(.*\\)\\s*$",
        "decreaseIndentPattern": "^\\s*endfn"
    }
}