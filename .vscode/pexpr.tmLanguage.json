{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "PExpr",
    "scopeName": "source.pexpr",
    "fileTypes": ["pexpr"],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#literals"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.pexpr",
                    "match": "//.*"
                },
                {
                    "name": "comment.block.pexpr",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.pexpr",
                    "match": "\\b(if|elif|else)\\b"
                },
                {
                    "name": "keyword.declaration.pexpr",
                    "match": "\\b(let|mut|fn|extern|as)\\b"
                },
                {
                    "name": "constant.language.boolean.pexpr",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.pexpr",
                    "match": "\\b(bool|int|num|vec2|vec3|vec4|str)\\b"
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "name": "constant.numeric.integer.pexpr",
                    "match": "\\b(0[bB][01]+|0[oO][0-7]+|0[xX][0-9a-fA-F]+|[0-9]+)\\b"
                },
                {
                    "name": "constant.numeric.float.pexpr",
                    "match": "\\b[0-9]+\\.[0-9]*([eE][+-]?[0-9]+)?\\b|\\b[0-9]*\\.[0-9]+([eE][+-]?[0-9]+)?\\b|\\b[0-9]+[eE][+-]?[0-9]+\\b"
                },
                {
                    "name": "string.quoted.double.pexpr",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.pexpr",
                            "match": "\\\\[\\\\\"'tnrabvfr0xuU]"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.pexpr",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.pexpr",
                            "match": "\\\\[\\\\\"'tnrabvfr0xuU]"
                        }
                    ]
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.pexpr",
                    "match": "="
                },
                {
                    "name": "keyword.operator.arithmetic.pexpr",
                    "match": "[+\\-*/%^]"
                },
                {
                    "name": "keyword.operator.comparison.pexpr",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.logical.pexpr",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.misc.pexpr",
                    "match": "\\.|,|:|;|->"
                },
                {
                    "name": "punctuation.parenthesis.pexpr",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.brace.pexpr",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.bracket.pexpr",
                    "match": "[\\[\\]]"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.other.pexpr",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}
