@[extern] fn getInput() -> num;

// Intrinsics (defined in Intrinsics.cpp)
@[extern, pure] fn sin(a:num) -> num;
@[extern, pure] fn cos(a:num) -> num;
@[extern, pure] fn tan(a:num) -> num;
@[extern, pure] fn asin(a:num) -> num;
@[extern, pure] fn acos(a:num) -> num;
@[extern, pure] fn atan(a:num) -> num;

@[extern, pure] fn abs(a:num) -> num;
@[extern, pure] fn sqrt(a:num) -> num;
@[extern, pure] fn pow(a:num, b:num) -> num;

// https://en.wikipedia.org/wiki/List_of_trigonometric_identities

// Basic identities (we can not assume a/b with b != 0)
fn identity_b1(a:num) = a*a;            // = a^2     [Done]
fn identity_b2(a:num) = -(-a);          // = a       [Done]
fn identity_b3(a:num, b:num) = (a^b)*a; // = a^(b+1)
fn identity_b4(a:num) = sqrt(a)^2;      // = abs(a)
fn identity_b5(a:num) = sqrt(a^2);      // = abs(a)
fn identity_b6(a:num) = a + 0;          // = a
fn identity_b7(a:num) = a - 0;          // = a
fn identity_b8(a:num) = a * 1;          // = a
fn identity_b9(a:num) = a / 1;          // = a

// -> The idea is to get rid of as many trigonometric functions as possible
//    This is not always a good idea. Especially when the equation can be reordered
//    to collapse to e.g., sin(a)^2 + cos(a)^2

fn identity_t1(a:num) = sin(a)^2 + cos(a)^2; // = 1

fn identity_t2(a:num, b:num) = sin(a)*cos(b) + cos(a)*sin(b); // = sin(a + b)
fn identity_t3(a:num, b:num) = sin(a)*cos(b) - cos(a)*sin(b); // = sin(a - b)
fn identity_t4(a:num, b:num) = cos(a)*cos(b) + sin(a)*sin(b); // = cos(a - b)
fn identity_t5(a:num, b:num) = cos(a)*cos(b) - sin(a)*sin(b); // = cos(a + b)

fn identity_t6(a:num) = 2*sin(a)*cos(a);       // = sin(2*a)
fn identity_t7(a:num) = 2*cos(a)*cos(a) - 1;   // = cos(2*a)
fn identity_t8(a:num) = 3*sin(a) - 4*sin(a)^3; // = sin(3*a)
fn identity_t9(a:num) = 4*cos(a)^3 - 3*cos(a); // = cos(3*a)
// -> Or Chebyshev method

fn identity_t10(a:num) = (1-cos(2*a)) / 2; // = sin(a)^2
fn identity_t11(a:num) = (1+cos(2*a)) / 2; // = cos(a)^2
fn identity_t12(a:num) = (1-cos(4*a)) / 8; // = sin(a)^2*cos(a)^2 (actually not that good)

fn identity_t13(a:num) = sin(asin(a)); // = a           [Done]
fn identity_t14(a:num) = cos(asin(a)); // = sqrt(1-a^2)
fn identity_t15(a:num) = sin(acos(a)); // = sqrt(1-a^2)
fn identity_t16(a:num) = cos(acos(a)); // = a           [Done] 
fn identity_t17(a:num) = tan(atan(a)); // = a           [Done]

0
    + identity_b1(getInput())
    + identity_b2(getInput())
    + identity_b3(getInput(), getInput())
    + identity_b4(getInput())
    + identity_b5(getInput())
    + identity_t1(getInput()) 
    + identity_t2(getInput(), getInput()) 
    + identity_t3(getInput(), getInput()) 
    + identity_t4(getInput(), getInput()) 
    + identity_t5(getInput(), getInput()) 
    + identity_t6(getInput()) 
    + identity_t7(getInput()) 
    + identity_t8(getInput()) 
    + identity_t9(getInput()) 
    + identity_t10(getInput()) 
    + identity_t11(getInput()) 
    + identity_t12(getInput()) 
    + identity_t13(getInput()) 
    + identity_t14(getInput()) 
    + identity_t15(getInput()) 
    + identity_t16(getInput()) 
    + identity_t17(getInput()) 