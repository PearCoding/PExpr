// Branch with phi node and multiple variables
[[extern, pure]] fn getInput() -> num;

let mut x:num = 0;
let branch_phi = if getInput() < 0.5 {
    x = 12;
    let x = 10; //< TODO: This should be an error or at least a warning!
    x
} else {
    x = 42;
    20
};

// This should produces two phi nodes
// -> one for branch_phi and one for x
// In the case of true it would return 22, else 62
branch_phi + x