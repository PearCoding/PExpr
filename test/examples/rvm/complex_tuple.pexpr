fn returns_nested(a: int, b: [bool, num]) -> [int, [bool, num]] = {
    [a, b]
};

fn main() -> int = {
    let k = [true, 3.14];
    let x = returns_nested(42, k);
    let *[a, [b, c]] = x;
    a
};

main()

